# ==============================================================================
# AGENTIC LOAN DECISION SYSTEM — ENVIRONMENT TEMPLATE
# ==============================================================================
# How to use:
#   Local dev  → cp .env.template .env  then fill in your keys
#   Render     → paste each key into the "Environment Variables" panel
#   Streamlit  → paste relevant keys into the app's "Secrets" panel (TOML format)
#
# Keys marked [REQUIRED] must be set for the system to function.
# Keys marked [OPTIONAL] have local fallbacks and can be added later.
# ==============================================================================


# ┌─────────────────────────────────────────────────────────────────────────┐
# │ 1. PRIMARY LLM — GROQ                                                   │
# │    Sign up free: https://console.groq.com                               │
# │    API key format: gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx                  │
# └─────────────────────────────────────────────────────────────────────────┘
GROQ_API_KEY=gsk_YOUR_KEY_HERE                        # [REQUIRED]
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MAX_TOKENS=8192                                  # [OPTIONAL]
GROQ_TEMPERATURE=0.1                                  # [OPTIONAL]

# ┌─────────────────────────────────────────────────────────────────────────┐
# │ 2. FALLBACK LLMs                                                        │
# │    System uses Groq first; falls back to these if Groq fails            │
# └─────────────────────────────────────────────────────────────────────────┘
OPENAI_API_KEY=sk-YOUR_OPENAI_KEY_HERE                # [OPTIONAL]
ANTHROPIC_API_KEY=sk-ant-YOUR_ANTHROPIC_KEY_HERE      # [OPTIONAL]

# ┌─────────────────────────────────────────────────────────────────────────┐
# │ 3. DATABASE — NEON.TECH SERVERLESS POSTGRES                             │
# │    Sign up free: https://neon.tech                                      │
# │    Project: loan-decision-system                                        │
# │    Copy the "Connection string" from the Neon dashboard                 │
# │    Format: postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/db    │
# └─────────────────────────────────────────────────────────────────────────┘
DATABASE_URL=postgresql://USER:PASS@ep-YOUR-ID.us-east-1.aws.neon.tech/neondb?sslmode=require
                                                      # [REQUIRED for audit trail]
                                                      # Falls back to local SQLite if blank

# ┌─────────────────────────────────────────────────────────────────────────┐
# │ 4. VECTOR DATABASE — CHROMA CLOUD                                       │
# │    Sign up free: https://trychroma.com                                  │
# │    Create a tenant, then get API key from Settings → API Keys           │
# └─────────────────────────────────────────────────────────────────────────┘
CHROMA_CLOUD_API_KEY=YOUR_CHROMA_API_KEY_HERE         # [OPTIONAL] local fallback if blank
CHROMA_CLOUD_TENANT=YOUR_TENANT_ID_HERE               # [OPTIONAL]
CHROMA_CLOUD_DATABASE=rbi_guidelines                  # [OPTIONAL] default shown
CHROMA_PERSIST_DIRECTORY=./data/embeddings            # [OPTIONAL] local path
CHROMA_COLLECTION_NAME=rbi_guidelines                 # [OPTIONAL]

# ┌─────────────────────────────────────────────────────────────────────────┐
# │ 5. MODEL STORAGE — HUGGING FACE HUB                                     │
# │    Sign up free: https://huggingface.co                                 │
# │    Create a Model repo, upload artefacts, then paste the repo ID here   │
# │    Repo must contain:                                                   │
# │      preprocessor.joblib                                                │
# │      scaler.joblib                                                      │
# │      explainer/shap_explainer.joblib                                    │
# │      explainer/lime_explainer.joblib                                    │
# │      loan_approval_model.h5          (optional)                         │
# └─────────────────────────────────────────────────────────────────────────┘
HUGGINGFACE_REPO_ID=your-username/loan-decision-assets  # [OPTIONAL] local fallback if blank
HUGGINGFACE_API_TOKEN=hf_YOUR_TOKEN_HERE                # [OPTIONAL] only for private repos

# ┌─────────────────────────────────────────────────────────────────────────┐
# │ 6. APPLICATION                                                          │
# └─────────────────────────────────────────────────────────────────────────┘
ENVIRONMENT=production                                # [REQUIRED] production | development
LOG_LEVEL=INFO                                        # [OPTIONAL] DEBUG | INFO | WARNING
DEBUG=false                                           # [OPTIONAL]
PORT=8000                                             # [OPTIONAL] Render sets $PORT automatically

# ┌─────────────────────────────────────────────────────────────────────────┐
# │ 7. SECURITY                                                             │
# │    Generate:  python -c "import secrets; print(secrets.token_hex(32))"  │
# └─────────────────────────────────────────────────────────────────────────┘
SECRET_KEY=GENERATE_A_RANDOM_64_CHAR_HEX_STRING_HERE  # [REQUIRED in production]
ALLOWED_HOSTS=your-api-name.onrender.com,localhost    # [REQUIRED in production]
CORS_ORIGINS=https://your-app.streamlit.app,http://localhost:8501
                                                      # [REQUIRED in production]

# ┌─────────────────────────────────────────────────────────────────────────┐
# │ 8. PATH OVERRIDES (rarely changed)                                      │
# └─────────────────────────────────────────────────────────────────────────┘
MODEL_CACHE_DIR=./models
DATA_CACHE_DIR=./data
SQLITE_PATH=./data/local_loan_decisions.db
